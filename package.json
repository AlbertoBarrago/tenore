{
  "name": "tenore-cli",
  "version": "0.2.0",
  "description": "Single-source config compiler for AI coding agents",
  "keywords": [
    "ai",
    "agents",
    "coding-agents",
    "claude-code",
    "codex",
    "antigravity",
    "agents-md",
    "mcp",
    "config",
    "permissions",
    "cli"
  ],
  "homepage": "https://albz.it/tenore/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlbertoBarrago/tenore.git"
  },
  "bugs": {
    "url": "https://github.com/AlbertoBarrago/tenore/issues"
  },
  "author": "Alberto Barrago (https://github.com/AlbertoBarrago)",
  "type": "module",
  "license": "MIT",
  "bin": {
    "tenore": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:schema": "node --experimental-strip-types scripts/gen-schema.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^14.0.3",
    "diff": "^9.0.0",
    "gray-matter": "^4.0.3",
    "smol-toml": "^1.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
